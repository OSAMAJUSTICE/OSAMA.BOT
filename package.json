{
  "name": "im-your-daddy-bot",
  "version": "3.20.41",
  "private": true,
  "description": "IM YOUR DADDY Discord bot with moderation, community, economy, voice and Quran features",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "check": "node scripts/check.js",
    "diagnose:i18n": "node scripts/translation-diagnostic.js",
    "dashboard": "node src/index.js",
    "backup": "node scripts/backup.js",
    "verify-db": "node scripts/verify-db.js",
    "audit": "npm audit --omit=dev",
    "test": "npm run check && node --test scripts/*.test.js",
    "test:security": "node --test scripts/security.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.6",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.19.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "ffmpeg-static": "^5.2.0",
    "opusscript": "^0.1.1",
    "@napi-rs/canvas": "^1.0.6",
    "gifenc": "^1.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "ffmpeg-static@5.3.0": true
  }
}
